From 94aa19e6776b7a3ce653ae612bf14df295caae59 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 5 Aug 2026 21:15:21 +0000
Subject: [PATCH 4/6] Raise temporary-redirect finding from warning to critical

Search Console confirmed the concrete consequence on this site: with the
apex issuing a 307 to www and no canonical tags present, Google selected
the apex as canonical and reported www as "Duplicate without user-selected
canonical". Google does not transfer canonical status across a temporary
redirect, so the host that serves nothing stayed canonical while every
real page went unindexed.

That is an indexing failure, not an equity leak, so it should not sort
below cosmetic warnings.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JzqKZ2Fpevm9Vp1hMULwPf
---
 scripts/seo/audit.py | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/scripts/seo/audit.py b/scripts/seo/audit.py
index 052cd01..69186a1 100644
--- a/scripts/seo/audit.py
+++ b/scripts/seo/audit.py
@@ -294,8 +294,15 @@ def site_checks(root):
             loc = rr.headers.get("Location", "")
             out[f"redirect_{host}"] = f"{rr.status} -> {loc}"
             if rr.status in (302, 307):
-                add("warn", "temp-redirect",
-                    f"{host} uses {rr.status} (temporary) -> should be 301/308 permanent")
+                # Not merely an equity leak. Google does not transfer canonical
+                # status across a temporary redirect, so the redirecting host
+                # stays canonical while the target serves the content. Paired
+                # with missing canonical tags, this is how a site ends up
+                # indexed under the hostname that serves nothing.
+                add("critical", "temp-redirect",
+                    f"{host} uses {rr.status} (temporary) -> should be 301/308. "
+                    "Google keeps the redirecting host canonical across a "
+                    "temporary redirect, so the wrong hostname gets indexed.")
         elif rr.status:
             out[f"redirect_{host}"] = f"{rr.status} (no redirect)"
     return out
