+name: Weekly SEO report
+
+on:
+  schedule:
+    # Mondays at 13:47 UTC. Off the hour on purpose — :00 is when every
+    # scheduled workflow on GitHub fires at once and runners queue.
+    - cron: "47 13 * * 1"
+  workflow_dispatch:
+
+# Needed to commit the state file back for week-over-week diffing.
+permissions:
+  contents: write
+
+concurrency:
+  group: seo-report
+  cancel-in-progress: false
+
+jobs:
+  report:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      # No pip install — the scripts are stdlib only.
+      - name: Crawl site and post report
+        env:
+          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
+        run: |
+          python3 scripts/seo/report.py https://www.sunleadsai.com \
+            --max 40 \
+            --state .github/seo-state.json
+
+      # Persisting state in the repo rather than actions/cache: a weekly job
+      # sits right on the 7-day cache eviction boundary, so the cache would
+      # often be gone exactly when it is needed.
+      - name: Commit updated state
+        run: |
+          if git diff --quiet -- .github/seo-state.json; then
+            echo "No change in SEO state."
+            exit 0
+          fi
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add .github/seo-state.json
+          git commit -m "chore: update SEO state [skip ci]"
+          git push
